<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">
	
	<!-- create line_items table -->
	<changeSet id="2025-create-organization_members-table" author="brian">
		<createTable tableName="organization_members">
			<column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
				<constraints primaryKey="true" nullable="false" unique="true" />
			</column>
			<column name="organization_id" type="uuid">
				<constraints
					nullable="false"
					foreignKeyName="fk_organization_members__organization__id"
					referencedTableName="organization"
					referencedColumnNames="id"
					deleteCascade="true"
				/>
			</column>
			<column name="user_id" type="uuid">
				<constraints
					nullable="false"
					foreignKeyName="fk_organization_members__user__user_id"
					referencedTableName="user_account"
					referencedColumnNames="user_id"
					deleteCascade="true"
				/>
			</column>
			<column name="role" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="is_creator" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="is_invited" type="boolean">
				<constraints nullable="false" />
			</column>
			<column name="invitation_by" type="uuid">
				<constraints
					nullable="true"
					foreignKeyName="fk_organization_members_invitation_by__user__user_id"
					referencedTableName="user_account"
					referencedColumnNames="user_id"
					deleteCascade="true"
				/>
			</column>
			<column name="invitation_date" type="date">
				<constraints nullable="true" />
			</column>
			<column name="status" type="varchar(100)">
				<constraints nullable="false" />
			</column>
			<column name="date_joined" type="date">
				<constraints nullable="true" />
			</column>
			<column name="date_updated" type="date">
				<constraints nullable="true" />
			</column>
		</createTable>
	</changeSet>
	
	<changeSet id="2026-add-unique-user-reference-check-in-organization-members" author="brian">
	    <sql>
	        ALTER TABLE organization_members 
	        ADD CONSTRAINT chk_different_users 
	        CHECK (user_id != invitation_by);
	    </sql>
	    
	    <rollback>
	        <sql>
	            ALTER TABLE organization_members 
	            DROP CONSTRAINT chk_different_users;
	        </sql>
	    </rollback>
	</changeSet>
</databaseChangeLog>