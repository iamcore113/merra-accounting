<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    logicalFilePath="db/changesets/organization/org-20261104-48.xml"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Entity maps phone_no as a JSON array; jsonb[] makes Hibernate bind NULL as bytea and fail on insert -->
    <changeSet id="2026-modify-column-type-contacts-phone_no" author="merra">
        <preConditions onFail="HALT">
            <dbms type="postgresql"/>
        </preConditions>
        <sql>
            ALTER TABLE app.contacts
            ALTER COLUMN phone_no TYPE jsonb
            USING array_to_json(phone_no)::jsonb;
        </sql>
    </changeSet>

</databaseChangeLog>

